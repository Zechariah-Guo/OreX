# Copy to .env and fill in. Never commit .env.

# Required in production: the app refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Trust one proxy hop (Nginx) for client IP and https. Keep 1 behind Nginx.
OREX_TRUST_PROXY=1

# Secure cookie flag. Remove this in production. Set to 0 ONLY when testing over plain http (e.g. docker on localhost),
# otherwise browsers drop the session cookie and login never sticks.
# SESSION_COOKIE_SECURE=0

# Avatar storage: local (default) or oci (oci is in requirements-prod.txt).
# For oci, the VM also needs an API key and config file at OCI_CONFIG_PATH.
# STORAGE_BACKEND=local
# OCI_NAMESPACE=
# OCI_BUCKET=orex-avatars
# OCI_CONFIG_PATH=~/.oci/config

# Web Push notifications (opt-in, Settings > Notifications). Leave all three
# empty to switch push off; the Settings card then says it is not configured.
# Generate a key pair once: python scripts/admin/generate_vapid_keys.py
# Keep the private key secret. Changing the pair means every device re-enables.
# Browsers need https (or localhost) for push.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Remove this is production. =1 means anyone can access /testing.
# OREX_ENABLE_TESTING_PAGE=1

# Local scripts only, never on a server: allow the public fallback SECRET_KEY. Remove this in production.
# OREX_ALLOW_DEFAULT_SECRET=1
